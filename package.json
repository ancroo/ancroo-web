    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "rollup@<2.80.0": ">=2.80.0",
